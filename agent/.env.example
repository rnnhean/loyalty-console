# ── agent ──────────────────────────────────────────────────
# 复制成 .env 后填值。真 key 只由部署环境注入，不写进仓库。
#
# ★ 本服务**不自动读 .env**（零运行时依赖，没有 dotenv）。
#   用 `pnpm dev:env`（即 `node --env-file=.env --import tsx src/server.ts`），
#   或者自己 `export`。生产环境由 compose 注入。

# 开关。0 / 空 → 所有入口 503，且不发起任何模型调用
AGENT_ENABLED=1

# 模型档位代号，只允许 M1 / M2 / M7 / M8（见技术设计 §6.2）
AGENT_MODEL=M1
AGENT_MODEL_FALLBACK=M11

# 供应商端点。兼容 OpenAI 的 /chat/completions 协议
AGENT_BASE_URL=http://127.0.0.1:9999/v1
AGENT_API_KEY=YOUR_KEY_HERE

# 单价：元 / 百万 token。**必须和 AGENT_MODEL 对得上**，
# 只换模型不换单价，预算闸门就会失真（§9）
AGENT_PRICE_IN=0
AGENT_PRICE_OUT=0
# 缓存读价。留空 = 按输入价算（保守）
AGENT_PRICE_CACHE_READ=

# 后端地址。生产用内网地址；开发走本机网关
AGENT_BACKEND_URL=http://127.0.0.1:8080

# 循环预算
AGENT_MAX_TURNS=10
AGENT_TIMEOUT_TOTAL_MS=45000
AGENT_TIMEOUT_TOOL_MS=8000
AGENT_TIMEOUT_IDLE_MS=20000

# 金额闸门：元 / 天。灰度期用 300
AGENT_DAILY_BUDGET_CNY=300

# 限流
AGENT_MAX_INFLIGHT=8
AGENT_USER_RPM=5

# 监听端口（前端开发期走 vite 代理）
AGENT_PORT=3001

# 诊断开关的本地缓存时长（秒）
AGENT_TOGGLE_TTL_SEC=60

# 假模型：1 时按 AGENT_FAKE_SCRIPT 指定的剧本回放，不联网。
# **ENV=prod 时必须为空**，否则启动直接退出
AGENT_FAKE_MODEL=
# 剧本路径，相对当前工作目录；启动时读一次，读不到/格式错就退出
AGENT_FAKE_SCRIPT=testdata/fake_script.json

# trace 落盘路径。留空则不落盘
AGENT_TRACE_FILE=

# 只允许 http(s)，且必须与 AGENT_BACKEND_URL 的 origin 一致
ENV=dev
