{
  "name": "loyalty-console-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "运营诊断助手的 agent 服务：分类、工具循环、引用校验、SSE",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "dev:env": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/agent/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "eval": "node --import tsx eval/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
