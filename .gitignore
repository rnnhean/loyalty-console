# 依赖与构建产物
node_modules/
dist/
*.log

# 抓取原始/中间数据：含未脱敏内容，不进仓库
# 整个目录都排除 —— 抓取产物的命名会变（.json / _seed.sql / .partial 等），
# 逐个列文件名必然漏，之前就漏过一个 370KB 的 _seed.sql。
scripts/data/

# 生产密钥与证书（部署时手工放到服务器，绝不提交）
deploy/.env.prod
deploy/certs/
deploy/certbot-www/

# 本地环境变量。只放过模板和分环境基线。
# 三套配置 deploy/env/{local,staging,prod}.env 和 web/.env.{development,staging,production}
# 是**故意入库**的：里面没有任何真实密钥，只有占位符和端口/限流这类公开参数。
# 真正的口令由部署环境注入（见 docs/CONFIGURATION.md）。
.env
.env.local
.env.*.local
web/.env
web/.env.local
web/.env.*.local
!*.env.example
!**/.env.prod.example

# 运行时
logs/
*.tsbuildinfo

# 测试产物
test-results/
playwright-report/
blob-report/
.playwright/
