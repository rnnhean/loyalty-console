# ─────────────────────────────────────────────────────────────
# 测试 / 预发环境（staging）
#
# ★ 状态：**未部署、未验证**。域名尚未确定，下面带 <<>> 的项必须先填。
#
# 与 local 的差别：
#   - 不再有开发期的放行开关（MC_ALLOW_DEV_SECRET 必须关）
#   - 所有口令走真实值，不放在仓库里
#   - 跨域要写上测试前端的域名
#   - 日志级别用 info，与生产一致，提前暴露噪音问题
#
# 启动：
#   MC_ENV=staging MC_ENV_FILE=deploy/env/staging.env \
#     docker compose -f deploy/docker-compose.staging.yml up -d
# ─────────────────────────────────────────────────────────────

MC_ENV=staging

# ── 监听 ──
# 测试环境的网关也会被 nginx 反代，绑所有网卡（容器内网段隔离靠 compose）。
MC_ADDR=:8080

# ── 鉴权 ──
# ★ 必须由部署环境注入真实值，本文件留空占位。
#   密钥生成：openssl rand -base64 48（至少 32 字节）
MC_TOKEN_SECRET=
MC_ADMIN_USER=admin
MC_ADMIN_PASS=
MC_TOKEN_TTL_MIN=720
# 测试环境也不允许用临时密钥：一重启全体掉线会让测试无法复现问题。
MC_ALLOW_DEV_SECRET=0

# ── MySQL ──
# ★ 域名待定。若是单机 compose 部署，写服务名即可：
#   MC_MYSQL_DSN=app:<password>@tcp(mysql:3306)/mc_core?charset=utf8mb4&parseTime=true&loc=Local
MC_MYSQL_DSN=
MC_MYSQL_MAX_OPEN=16
MC_MYSQL_MAX_IDLE=4

# ── Redis ──
MC_REDIS_ADDR=redis:6379
MC_REDIS_DB=0
MC_REDIS_PASSWORD=

# ── 消息队列与对象存储 ──
MC_KAFKA_BROKERS=kafka:9092
MC_KAFKA_TOPIC=console.events
MC_KAFKA_GROUP=console-audit

MC_RABBIT_URL=amqp://mc:<password>@rabbitmq:5672/%2Fconsole

# ★ 公共端点待定：预签名 URL 把 Host 算进了签名，
#   填内网地址浏览器会拿到 SignatureDoesNotMatch。
MC_BLOB_ENDPOINT=minio:9000
MC_BLOB_PUBLIC_ENDPOINT=<<staging-file-host:port>>
MC_BLOB_USE_SSL=0
MC_BLOB_ACCESS_KEY=
MC_BLOB_SECRET_KEY=
MC_BLOB_EXPORT_BUCKET=console-export
MC_BLOB_TMP_BUCKET=console-tmp

# ── 限流 ──
# 比生产宽松一档：测试会跑压测和回归脚本，卡太死会误伤。
MC_RATE_RPS=60
MC_RATE_BURST=120
MC_LOGIN_RPS=5
MC_TELEMETRY_RPS=100
# 按「路由 + 业务 ID」分桶的第二层限流，同样跟着放宽一档
MC_BIZ_RPS=20
MC_BIZ_BURST=40

# ── 跨域 ──
# ★ 域名待定。前后端分域时才需要，同域部署留空。
MC_CORS_ORIGINS=

# ── 日志 ──
MC_LOG_LEVEL=info
