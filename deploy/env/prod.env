# ─────────────────────────────────────────────────────────────
# 生产环境（prod）
#
# ★ 状态：**未部署、未验证**。域名尚未确定，下面带 <<>> 的项必须先填。
#
# 与 local / staging 的关键差别：
#   - 所有口令、密钥一律由部署环境注入，本文件**不存任何真实值**
#   - MC_ALLOW_DEV_SECRET 关闭：密钥丢失应启动失败，而不是偷偷用临时密钥
#   - 日志级别 info，容器日志已配 20MB × 5 轮转
#   - 速率限制收紧
#
# 启动：
#   MC_ENV=prod docker compose -f deploy/docker-compose.prod.yml up -d
#   （生产不用本文件的多数项——compose 的 environment 段直接注入；
#     本文件作为「完整变量清单 + 推荐值」的参考，以及对齐三套配置的基线）
# ─────────────────────────────────────────────────────────────

MC_ENV=prod

# ── 监听 ──
# 容器内监听所有网卡，但 compose 里只 expose 不 publish，
# 只有 nginx 在 edge 网段能访问到。
MC_ADDR=:8080

# ── 鉴权 ──
# ★ 全部由 MC_TOKEN_SECRET / MC_ADMIN_USER / MC_ADMIN_PASS 环境变量注入。
#   生成密钥：openssl rand -base64 48
MC_TOKEN_SECRET=
MC_ADMIN_USER=
MC_ADMIN_PASS=
# 12 小时：够一个工作日，又不至于长期不换
MC_TOKEN_TTL_MIN=720
# ★★ 生产禁用临时密钥。关掉后未设 MC_TOKEN_SECRET 时启动直接失败，
#     这比「静悄悄用随机密钥、重启后所有人掉线」安全得多。
MC_ALLOW_DEV_SECRET=0

# ── MySQL ──
# 由 compose 注入，形如 app:<password>@tcp(mysql:3306)/mc_core?...
MC_MYSQL_DSN=
# 生产连接池比本地大：并发高时池子太小会把请求排队
MC_MYSQL_MAX_OPEN=32
MC_MYSQL_MAX_IDLE=8

# ── Redis ──
MC_REDIS_ADDR=redis:6379
MC_REDIS_DB=0
MC_REDIS_PASSWORD=

# ── 消息队列与对象存储 ──
MC_KAFKA_BROKERS=kafka:9092
MC_KAFKA_TOPIC=console.events
MC_KAFKA_GROUP=console-audit

MC_RABBIT_URL=amqp://mc:<password>@rabbitmq:5672/%2Fconsole

# ★ 必须是公网可达的真实域名，预签名 URL 会把 Host 算进签名。
MC_BLOB_ENDPOINT=minio:9000
MC_BLOB_PUBLIC_ENDPOINT=<<api-file-domain:port>>
MC_BLOB_USE_SSL=0
MC_BLOB_ACCESS_KEY=
MC_BLOB_SECRET_KEY=
MC_BLOB_EXPORT_BUCKET=console-export
MC_BLOB_TMP_BUCKET=console-tmp

# ── 限流 ──
# 上线初期按「单实例能撑住」估，有真实流量后按监控数据调。
MC_RATE_RPS=30
MC_RATE_BURST=60
# 登录单独限到 2 QPS：这是防暴力破解的第一道闸
MC_LOGIN_RPS=2
MC_TELEMETRY_RPS=50
# 按「路由 + 业务 ID」分桶的第二层限流，防多来源刷同一条数据。
# 它统计所有来源对同一个 ID 的合计，所以比 MC_RATE_RPS 松一档是正常的；
# 但必须明显低于「那一行扛不住」的量，否则这层没有意义。
MC_BIZ_RPS=10
MC_BIZ_BURST=20

# ── 跨域 ──
# 同域部署（nginx 把 /api 和静态资源放在同一个域名下）时留空。
# 前后端分域时填真实域名，例如 https://console.example.com
MC_CORS_ORIGINS=

# ── 日志 ──
# 生产用 info。debug 会打出请求参数级别的内容，既有性能开销，
# 也可能把用户数据写进日志。
MC_LOG_LEVEL=info
