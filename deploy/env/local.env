# ─────────────────────────────────────────────────────────────
# 本地开发环境（local）
#
# 这份文件是**唯一跑通过**的一套配置，直接可用。
# 中间件跑在 deploy/docker-compose.yml 起的容器里，端口是特意
# 避开默认值的那一套（13306 / 16379 / 19092 / 15672 / 19000）。
#
# 启动方式：
#   cd server && go run ./cmd/gateway
# 本文件会被自动加载，不需要再在命令行拼一长串变量。
#
# 优先级：真实环境变量 > 本文件 > 代码默认值。
# 想临时覆盖某一项，命令行前缀即可：
#   MC_LOG_LEVEL=debug go run ./cmd/gateway
# ─────────────────────────────────────────────────────────────

MC_ENV=local

# ── 监听 ──
# 只绑回环地址。默认的 :8080 会监听所有网卡，Windows 防火墙遇到新的
# 可执行文件路径就弹一次授权框；绑回环后不再弹。
# Prometheus 容器走 host.docker.internal 仍能抓到指标。
# 需要手机真机调试时临时改成 :8080。
MC_ADDR=127.0.0.1:8080

# ── 鉴权 ──
# 开发期用进程内随机密钥：不设 MC_TOKEN_SECRET，靠这个开关放行。
# ★ 公网部署绝不能开——重启会让所有人掉线。
MC_ALLOW_DEV_SECRET=1
MC_ADMIN_USER=admin
MC_ADMIN_PASS=demo1234
MC_TOKEN_TTL_MIN=720

# ── MySQL ──
# 对应 deploy/docker-compose.yml 里的 13306:3306 映射
MC_MYSQL_DSN=root:root123@tcp(127.0.0.1:13306)/mc_core?charset=utf8mb4&parseTime=true&loc=Local
MC_MYSQL_MAX_OPEN=32
MC_MYSQL_MAX_IDLE=8

# ── Redis ──
MC_REDIS_ADDR=127.0.0.1:16379
MC_REDIS_DB=0

# ── 消息队列与对象存储 ──
# 这三个组件在网关里是可降级的：没起来服务照常启动，
# 对应能力返回 503 或走降级分支。
MC_KAFKA_BROKERS=127.0.0.1:19092
MC_KAFKA_TOPIC=console.events
MC_KAFKA_GROUP=console-audit

# vhost 必须写成 %2Fconsole：直接写 /console 会被解析成名为
# "console" 的 vhost（少了前导斜杠），报 vhost not found。
# 端口注意：15674 是 AMQP 协议口；15672 是管理界面（浏览器开），别弄混。
MC_RABBIT_URL=amqp://mc:mc123@127.0.0.1:15674/%2Fconsole

MC_BLOB_ENDPOINT=127.0.0.1:19000
MC_BLOB_PUBLIC_ENDPOINT=127.0.0.1:19000
MC_BLOB_USE_SSL=0
MC_BLOB_ACCESS_KEY=mcadmin
MC_BLOB_SECRET_KEY=mcadmin123
MC_BLOB_EXPORT_BUCKET=console-export
MC_BLOB_TMP_BUCKET=console-tmp

# ── 限流 ──
# 第一层：按「路由 + 调用方」分桶
MC_RATE_RPS=30
MC_RATE_BURST=60
MC_LOGIN_RPS=2
MC_TELEMETRY_RPS=50
# 第二层：按「路由 + 业务 ID」分桶，防多来源刷同一条数据。
# 数值比上面松，因为它统计所有来源对同一个 ID 的合计。
MC_BIZ_RPS=10
MC_BIZ_BURST=20

# ── 跨域 ──
# 前端走 Vite 代理（5173 → 8080），浏览器看来是同源，这里留空。
MC_CORS_ORIGINS=

# ── 日志 ──
# debug 会打出更多细节；日常用 info 即可。
MC_LOG_LEVEL=info
