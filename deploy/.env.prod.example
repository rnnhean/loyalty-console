# 生产环境变量样例 —— 复制成 deploy/.env.prod 后填真实值。
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod
#   # 生成随机值：openssl rand -base64 48
#
# ★★ deploy/.env.prod 必须加到 .gitignore，绝不提交。
# ★★ 本文件里的所有值都是假的，不要当默认口令用。

# ── 应用版本（会写进前端 Sentry 的 release，回滚时靠它对比）──
APP_VERSION=1.0.0

# ── 鉴权 ──
# 签发登录 ticket 的 HMAC 密钥。改动会让所有已登录用户失效。
# 长度至少 32 字节；建议 openssl rand -base64 48
MC_TOKEN_SECRET=CHANGE_ME_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MC_TOKEN_TTL_MIN=720
MC_ADMIN_USER=admin
MC_ADMIN_PASS=CHANGE_ME_ADMIN_PASSWORD

# ── MySQL ──
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── RabbitMQ（延迟任务：权益到期回收等）──
# 管理界面不对外 publish，需要时用 SSH 隧道：
#   ssh -L 15672:127.0.0.1:15672 <host> 后再转发到容器
RABBIT_PASSWORD=CHANGE_ME_RABBIT_PASSWORD

# ── MinIO（导出文件存储，S3 协议）──
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=console-export
# 宿主机上 S3 API 的端口，仅用于浏览器下载预签名文件
MINIO_API_PORT=19000
# ★ 浏览器访问对象存储用的地址，必须和实际入口一致：
#   预签名 URL 把 Host 算进了签名，写成内网地址浏览器会拿到 SignatureDoesNotMatch。
#   只填 host:port（如 203.0.113.10:19000 或 oss.example.com），不带 http://。
MINIO_PUBLIC_HOST=localhost:19000

# ── Grafana ──
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
# 绑了 127.0.0.1:13000，默认只能通过 SSH 隧道访问；
# 真要暴露域名时改这里并确保走 HTTPS + 身份认证。
GRAFANA_ROOT_URL=http://localhost:13000

# ── 前端（构建期注入，会被打进 JS bundle）──
# ★ DSN 可以在浏览器看到，这是设计如此；但它决定错误上报去哪，
#   不要复用一个可能被滥用的公共 DSN。
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_ENV=production

# ── 跨域（前后端同域部署时留空）──
MC_CORS_ORIGINS=

# ── 日志 ──
MC_LOG_LEVEL=info
