# ─────────────────────────────────────────────────────────────
# 测试 / 预发环境（staging）
#
# ★ 状态：**未部署、未验证**。域名尚未确定，带 <<>> 的项必须先填。
#
# 构建：
#   cd web && pnpm build --mode staging
#
# 与 development 的差别：
#   - 不再是本机地址，走真实网关域名
#   - Sentry 环境标记为 staging，事件和线上分开统计
#   - 版本号由 CI 注入，便于对照发布记录
# ─────────────────────────────────────────────────────────────

# ★ 域名待定。
#   同域部署（nginx 把静态资源和 /api 放同一个域名）时留空即可，
#   前端请求 /api 会走相对路径，由 nginx 转发。
#   前后端分域时才需要填，例如 https://api-staging.example.com
VITE_API_ORIGIN=

# ── 监控 ──
# ★ 这里不定义 VITE_SENTRY_DSN：构建时由 compose 的 build args 注入。
#   一旦在这个文件里写了它（哪怕是空值或占位符），就会盖掉注入的值。
#   建议给 staging 单独建一个 Sentry 项目，别复用 production 的，
#   否则测试流量会污染线上的错误统计。
VITE_SENTRY_ENV=staging

# ── 版本号 ──
# release 名不在这里配置：由 vite.config.ts 统一计算
#   （命令行注入的 VITE_APP_VERSION > <package.json version>+<git sha>）。
# CI 要按发布号对照记录，就在构建命令前显式传 VITE_APP_VERSION=staging-20261109-a1b2c3d。
