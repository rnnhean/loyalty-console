# 复制成 .env.local 后按需填写。带 VITE_ 前缀的变量会被打进前端包，
# 所以**绝不能**把密钥、口令、后端内网地址以外的敏感信息放在这里。

# --- 监控 ---
# Sentry DSN。留空则前端只上报自建 beacon（/api/telemetry/beacon），不接 SaaS。
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
VITE_APP_VERSION=dev

# --- 开发期 ---
# vite server 把 /api 代理到这个地址。生产环境同源部署时不生效。
VITE_API_ORIGIN=http://127.0.0.1:8080
